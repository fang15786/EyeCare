<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eyecare.app">

    <!-- 悬浮窗权限：用于在屏幕最上层显示护眼半透明全屏遮罩 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务权限：确保在后台常驻监听亮屏与计时 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知权限 (Android 13+)：用于在下拉通知栏显示前台常驻倒计时 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 忽略电池优化权限：确保后台长效保活，防止锁屏被系统冻结挂起 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 开机自启权限：可选自启动护眼保活 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 注意：根据纯视觉静默需求，本应用坚决不申请 android.permission.VIBRATE 权限，无任何震动与声音 -->

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_dialog_info"
        android:supportsRtl="true"
        android:theme="@style/Theme.EyeCare">

        <!-- 主控制入口 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 护眼核心前台服务：负责监听亮屏广播、累计计时以及弹出与销毁悬浮遮罩 -->
        <service
            android:name=".EyeCareService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="EyeCare 20-20-20 screen usage timer and overlay reminder" />
        </service>

        <!-- 静态广播接收器：监听用户解锁屏幕 (ACTION_USER_PRESENT) 与系统开机，被杀后一解锁自动拉活服务 -->
        <receiver
            android:name=".BootAndUnlockReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- 用户解锁手机屏幕（Google 官方隐式广播豁免清单） -->
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- 手机开机自启 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 应用覆盖安装/升级完成 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
